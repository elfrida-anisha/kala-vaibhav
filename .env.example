# ==========================================
# Kala Vaibhav Environment Configuration
# ==========================================

# Go Backend Server
PORT=8080
DATA_DIR=data
UPLOAD_DIR=uploads
GIN_MODE=release

# Database (Supabase PostgreSQL)
# When not provided, the application runs on its built-in self-seeding, thread-safe JSON persistence store
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=

# Razorpay Payment Gateway (Test Mode)
# Leave empty to automatically use the labelled Demo Checkout fallback with full signature simulation
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI & Voice Services
# Local Ollama endpoint (runs llama3.2 or compatible LLM)
OLLAMA_HOST=http://localhost:11434

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api
